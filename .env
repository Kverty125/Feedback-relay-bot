# Copy this file to .env and fill it in. NEVER commit .env!

# Bot token from @BotFather (required)
BOT_TOKEN=

# Password that grants admin rights: send it to the bot in a private chat.
# Leave empty to disable password login.
ADMIN_PASSWORD=

# Or set admin Telegram IDs directly, comma-separated (find yours via @userinfobot)
ADMIN_IDS=

# Optional
# WELCOME_TEXT=Hello! Send your message and an administrator will reply.
# DATA_FILE=bot_data.json
# ENABLE_WEB=1     # tiny web server for hosts like Render
# PORT=10000
